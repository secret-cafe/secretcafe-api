generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// ======================================================
// ENUMS
// ======================================================
//

enum TableType {
  FAMILY
  POD
  HALL
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
}

enum SessionStatus {
  ACTIVE
  CLOSED
  CANCELLED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIAL
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  CASH_ONLINE
}

enum DiscountType {
  PERCENTAGE
  AMOUNT
}

model UserInfo {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  userId      String?    @unique @db.VarChar(36)
  roleId      Int?      @db.UnsignedInt
  name        String
  username    String
  email       String    @db.VarChar(255)
  password    String    @db.VarChar(255)
  phoneNumber String?   @db.VarChar(20)
  isActive    Boolean   @default(true)
  createdBy   Int?      @db.UnsignedInt
  updatedBy   Int?      @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  role        Roles?    @relation(fields: [roleId], references: [id])

  @@index([deletedAt])
  @@index([userId])
  @@index([roleId], map: "UserInfo_roleId_fkey")
}

model Roles {
  id          Int        @id @default(autoincrement()) @db.UnsignedInt
  roleId      String?     @unique @db.VarChar(36)
  name        String     @unique
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true)
  createdBy   Int?       @db.UnsignedInt
  updatedBy   Int?       @db.UnsignedInt
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  users       UserInfo[]

  @@index([deletedAt])
  @@index([roleId])
}

model Category {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  categoryId  String?   @unique @db.VarChar(36)
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(5000)
  publicId    String?   @db.VarChar(255)
  imageUrl    String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdBy   Int?      @db.UnsignedInt
  updatedBy   Int?      @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  menuItems MenuItem[]

  @@index([deletedAt])
  @@index([categoryId])
}

model MenuItem {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  categoryId  Int       @db.UnsignedInt
  name        String    @db.VarChar(255)
  price       Decimal   @db.Decimal(10, 2)
  menuType    String    @db.VarChar(255)
  available   Boolean   @default(true)
  publicId    String?   @db.VarChar(255)
  imageUrl    String?   @db.VarChar(500)
  description String?   @db.VarChar(5000)
  createdBy   Int?      @db.UnsignedInt
  updatedBy   Int?      @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  category     Category      @relation(fields: [categoryId], references: [id], onUpdate: Cascade)
  menuSubMenus MenuSubMenu[]
  orderItems   OrderItem[]

  @@index([deletedAt])
  @@index([categoryId])
}

model SubMenuItem {
  id          Int       @id @default(autoincrement()) @db.UnsignedInt
  name        String    @db.VarChar(255)
  price       Decimal   @db.Decimal(10, 2)
  available   Boolean   @default(true)
  imageUrl    String?   @db.VarChar(500)
  description String?   @db.VarChar(5000)
  createdBy   Int?      @db.UnsignedInt
  updatedBy   Int?      @db.UnsignedInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  menuSubMenus      MenuSubMenu[]
  orderSubMenuItems OrderSubMenuItem[]

  @@index([deletedAt])
}

model MenuSubMenu {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  menuItemId    Int      @db.UnsignedInt
  subMenuItemId Int      @db.UnsignedInt
  createdAt     DateTime @default(now())
  createdBy     Int?     @db.UnsignedInt
  updatedAt     DateTime @updatedAt
  updatedBy     Int?     @db.UnsignedInt
  deletedAt     DateTime?

  // Relations
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  subMenuItem SubMenuItem @relation(fields: [subMenuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([subMenuItemId])
}

model RestaurantTable {
  id              Int         @id @default(autoincrement()) @db.UnsignedInt
  name            String      @db.VarChar(100)
  type            TableType
  tableStatus     TableStatus @default(AVAILABLE)
  capacity        Int
  guestCount      Int?
  tableToken      String?     @db.VarChar(500)
  qrCodeImageUrl  String?     @db.VarChar(500)
  publicId        String?     @db.VarChar(255)
  enableTimeRate  Boolean     @default(false)
  ratePerMinute   Decimal?    @db.Decimal(10, 2)
  ratePerHour     Decimal?    @db.Decimal(10, 2)
  chargePerPerson Boolean?
  rushMode        Boolean     @default(false)
  isActive        Boolean     @default(true)
  createdBy       Int?        @db.UnsignedInt
  updatedBy       Int?        @db.UnsignedInt
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Relations
  tableSessions TableSession[]
  orders        Order[]

  @@index([type])
  @@index([tableStatus])
  @@index([deletedAt])
}

model TableSession {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  tableId          Int           @db.UnsignedInt
  status           SessionStatus @default(ACTIVE)
  guestCount       Int
  enableTimeRate   Boolean       @default(false)
  ratePerMinute    Decimal?      @db.Decimal(10, 2)
  ratePerHour      Decimal?      @db.Decimal(10, 2)
  chargePerPerson  Boolean?
  rushMode         Boolean       @default(false)
  totalMinutes     Int?          @default(0)
  timeChargeAmount Decimal?      @db.Decimal(10, 2)
  startedAt        DateTime?
  endedAt          DateTime?
  timerStartedAt   DateTime?
  timerEndedAt     DateTime?
  notes            String?       @db.Text
  handledBy        Int?          @db.UnsignedInt
  createdBy        Int?          @db.UnsignedInt
  updatedBy        Int?          @db.UnsignedInt
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relations
  table    RestaurantTable @relation(fields: [tableId], references: [id])
  orders   Order[]
  billings Billing[]

  @@index([status])
  @@index([tableId])
}

model Order {
  id               Int           @id @default(autoincrement()) @db.UnsignedInt
  orderNumber      String        @unique @db.VarChar(50)
  sessionId        Int           @db.UnsignedInt
  tableId          Int           @db.UnsignedInt
  orderType        OrderType     @default(DINE_IN)
  status           OrderStatus   @default(PENDING)
  paymentStatus    PaymentStatus @default(UNPAID)
  subtotal         Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge    Decimal       @default(0) @db.Decimal(10, 2)
  timeChargeAmount Decimal?      @db.Decimal(10, 2)
  totalAmount      Decimal       @default(0) @db.Decimal(10, 2)
  notes            String?       @db.Text
  placedBy         Int?          @db.UnsignedInt
  acceptedBy       Int?          @db.UnsignedInt
  placedAt         DateTime      @default(now())
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  // Relations
  session  TableSession    @relation(fields: [sessionId], references: [id])
  table    RestaurantTable @relation(fields: [tableId], references: [id])
  billings Billing[]

  items    OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([sessionId])
  @@index([tableId])
  @@index([status])
}

model OrderItem {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  orderId     Int         @db.UnsignedInt
  menuItemId  Int?        @db.UnsignedInt
  quantity    Int         @default(1)
  unitPrice   Decimal     @db.Decimal(10, 2)
  totalPrice  Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  notes       String?     @db.VarChar(500)
  isCancelled Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  // Relations
  order             Order        @relation(fields: [orderId], references: [id])
  menuItem          MenuItem?    @relation(fields: [menuItemId], references: [id])
  orderSubMenuItem  OrderSubMenuItem[]
  statusHistory     OrderStatusHistory[]

  @@index([orderId])
}

model OrderSubMenuItem {
  id            Int       @id @default(autoincrement()) @db.UnsignedInt
  orderItemId   Int       @db.UnsignedInt
  subMenuItemId Int?      @db.UnsignedInt
  quantity      Int       @default(1)
  unitPrice     Decimal   @db.Decimal(10, 2)
  totalPrice    Decimal   @db.Decimal(10, 2)
  notes         String?   @db.VarChar(500)
  isCancelled   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])
  subMenuItem SubMenuItem? @relation(fields: [subMenuItemId], references: [id])

  @@index([orderItemId])
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement()) @db.UnsignedInt
  orderId     Int         @db.UnsignedInt
  itemId      Int?        @db.UnsignedInt
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedBy   Int?        @db.UnsignedInt
  reason      String?     @db.VarChar(500)
  metadata    Json?       @db.Json
  createdAt   DateTime    @default(now())

  order   Order      @relation(fields: [orderId], references: [id])
  item    OrderItem? @relation(fields: [itemId], references: [id])

  @@index([orderId, createdAt])
  @@index([itemId])
  @@index([toStatus])
}

model Billing {
  id                Int            @id @default(autoincrement()) @db.UnsignedInt
  sessionId         Int            @db.UnsignedInt
  orderId           Int?           @db.UnsignedInt
  billNumber        String         @unique @db.VarChar(50)
  subtotal          Decimal        @db.Decimal(10, 2)
  timeChargeAmount  Decimal?       @db.Decimal(10, 2)
  taxAmount         Decimal        @default(0) @db.Decimal(10, 2)
  discountAmount    Decimal        @default(0) @db.Decimal(10, 2)
  serviceCharge     Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount       Decimal        @db.Decimal(10, 2)
  cashAmount        Decimal?       @db.Decimal(10, 2)
  onlineAmount      Decimal?       @db.Decimal(10, 2)
  paymentStatus     PaymentStatus  @default(UNPAID)
  paymentMethod     PaymentMethod?
  paidAt            DateTime?
  mobileNumber      String?        @db.VarChar(20)
  notes             String?        @db.Text
  createdBy         Int?           @db.UnsignedInt
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  session          TableSession      @relation(fields: [sessionId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  billingDiscounts BillingDiscount[]

  @@index([sessionId])
  @@index([paymentStatus])
}

model Discount {
  id          Int          @id @default(autoincrement()) @db.UnsignedInt
  name        String       @db.VarChar(255)
  description String?      @db.VarChar(5000)
  type        DiscountType
  value       Decimal      @db.Decimal(10, 2)
  isActive    Boolean      @default(true)
  createdBy   Int?         @db.UnsignedInt
  updatedBy   Int?         @db.UnsignedInt
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  // Relations
  billingDiscounts BillingDiscount[]

  @@index([deletedAt])
}

model BillingDiscount {
  id             Int          @id @default(autoincrement()) @db.UnsignedInt
  billingId      Int          @db.UnsignedInt
  discountId     Int          @db.UnsignedInt
  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @db.Decimal(10, 2)
  sequence       Int          @default(1)
  createdAt      DateTime     @default(now())

  // Relations
  billing  Billing  @relation(fields: [billingId], references: [id], onDelete: Cascade)
  discount Discount @relation(fields: [discountId], references: [id])

  @@index([billingId])
  @@index([discountId])
}

model InventoryItem {
  id                Int       @id @default(autoincrement()) @db.UnsignedInt
  inventoryId       String    @unique @db.VarChar(36)
  name              String    @db.VarChar(255)
  sku               String    @unique @db.VarChar(100)
  unit              String    @db.VarChar(50)
  quantity          Decimal   @default(0) @db.Decimal(10, 2)
  lowStockThreshold Decimal   @default(0) @db.Decimal(10, 2)
  isActive          Boolean   @default(true)
  createdBy         Int?      @db.UnsignedInt
  updatedBy         Int?      @db.UnsignedInt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@index([deletedAt])
  @@index([inventoryId])
}
